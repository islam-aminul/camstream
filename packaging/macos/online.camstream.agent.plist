<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>online.camstream.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/java</string>
    <string>-XX:MaxRAMPercentage=50</string>
    <string>-jar</string>
    <string>/usr/local/camstream/camstream-agent.jar</string>
    <string>/usr/local/etc/camstream/agent.yaml</string>
  </array>

  <key>RunAtLoad</key><true/>
  <!-- A camera outage must not become an agent outage. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>WorkingDirectory</key><string>/usr/local/var/camstream</string>
  <key>StandardOutPath</key><string>/usr/local/var/log/camstream-agent.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/camstream-agent.log</string>
</dict>
</plist>
