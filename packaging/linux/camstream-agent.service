[Unit]
Description=CamStream edge ingestion agent
Documentation=https://github.com/islam-aminul/camstream
# Discovery and RTSP both need the network genuinely up, not merely configured.
After=network-online.target
Wants=network-online.target
# Belongs in [Unit], not [Service]: never give up restarting, since an
# unattended box has nobody to run `systemctl reset-failed`.
StartLimitIntervalSec=0

[Service]
Type=simple
User=camstream
Group=camstream
WorkingDirectory=/var/lib/camstream
# A staged update is applied here, before the JVM opens the jar: the agent
# cannot replace the file it is running from, and this is the moment nothing
# holds it open. The previous jar is kept, so if a new build will not start,
# that is the copy that did.
#
# Prefixed with "+" so it runs as root rather than as the service user. The
# installation directory is deliberately not writable by the agent - neither by
# ownership nor under ProtectSystem=strict - so the agent stages the download
# into its own state directory and this step is what installs it. Without the
# prefix the swap fails on permissions and the update is silently lost, which
# is exactly what happened on the first real Linux install.
ExecStartPre=+/bin/sh -c 'j=/opt/camstream/camstream-agent.jar; n=/var/lib/camstream/camstream-agent.jar.new; [ -f "$n" ] || n="$j.new"; [ -f "$n" ] || exit 0; cp -f "$j" "$j.previous"; mv -f "$n" "$j"; chown root:root "$j"; chmod 0644 "$j"'
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=50 -jar /opt/camstream/camstream-agent.jar /etc/camstream/agent.yaml

# A camera outage must not become an agent outage. The agent already retries
# internally; this covers the process dying outright.
Restart=always
RestartSec=10s

# Logs go to the journal — use `journalctl -u camstream-agent -f`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camstream-agent

# The agent needs outbound network and its own state directory, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/camstream
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# ffmpeg and ffprobe are spawned as children, so no exec restriction here.

[Install]
WantedBy=multi-user.target
