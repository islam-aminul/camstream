<!--
  WinSW service definition.

  WinSW (MIT) is the cleanest way to run a JVM as a real Windows service: Java
  cannot answer the Service Control Manager itself, so something has to sit
  between them. It is not bundled — install.ps1 fetches it, or you can drop
  WinSW.exe next to this file and rename it camstream-agent.exe.
-->
<service>
  <id>camstream-agent</id>
  <name>CamStream Agent</name>
  <description>Publishes on-premises CCTV cameras to CamStream.</description>

  <executable>java</executable>
  <arguments>-XX:MaxRAMPercentage=50 -jar "%BASE%\camstream-agent.jar" "%ProgramData%\CamStream\agent.yaml"</arguments>

  <workingdirectory>%ProgramData%\CamStream</workingdirectory>

  <!-- A camera outage must not become an agent outage. -->
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>

  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <keepFiles>7</keepFiles>
  </log>
  <logpath>%ProgramData%\CamStream\logs</logpath>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
</service>
