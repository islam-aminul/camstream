# Node
node_modules/
dist/
*.tsbuildinfo

# CDK
infra/cdk.out/
infra/.cdk.staging/

# Java
agent/target/
*.class

# Secrets & keys — never commit
*.pem
!infra/keys/*public*.pem

# The public halves of the release signing keys, which the agent must carry to
# verify an update package at all. Safe by construction - the private halves
# exist only inside KMS and cannot be exported - and the blanket *.pem rule
# above silently swallowed this once already, producing a build that trusted
# nothing and would have refused every signed update it was offered.
!agent/src/main/resources/signing-keys.pem
certs/
.env
.env.*
!.env.example

# Local
.DS_Store
*.log
scratch/

# Enrolled device identities — private keys, never commit
devices/

# Local scratch: account id is resolved from credentials at deploy time
aws-account

# Playwright MCP scratch output
.playwright-mcp/

# tsc output. The CDK app runs through ts-node and the lambdas are bundled by
# esbuild, so nothing here is ever the artefact that ships — but `npm run build`
# in infra/ emits it, and it once went into a commit.
infra/bin/*.js
infra/lib/*.js
infra/lambda/**/*.js
